# --- Run identity ---------------------------------------------
# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------
PG_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Models ---------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_VERSION=claude-sonnet-4-6

# --- Tracing --------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Run identity ---------------------------------------------
RUN_LABEL=v1_baseline
POLICY_VERSION=1.0
AUTONOMY_LEVEL=L0

# --- Endpoints ------------------------------------------------
PAYMENT_ENDPOINT=http://host.docker.internal:8100/payments
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- Deferred controls (recorded, not enforced at L0) ----------
CONFIDENCE_THRESHOLD=0.95
AUTO_APPROVE_VALUE_CAP=100
SAMPLING_RATE=0

# --- Extraction -----------------------------------------------
EXTRACTION_MODE=stub
LEGIBILITY_THRESHOLD=0.
